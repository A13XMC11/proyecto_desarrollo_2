PORT=3977
# PostgreSQL (Sequelize): docentes, cursos, estudiantes, generaciones y cuotas de IA
SQL_URL=postgres://postgres@127.0.0.1:5432/minijuegos_dev
# true (por defecto) ajusta las tablas a los modelos al arrancar; false en producción
SQL_SYNC_ALTER=true
# MongoDB (Mongoose): juegos, versiones, partidas, canales e interacciones
MONGO_URI=mongodb://127.0.0.1:27017/minijuegos-dev
# Bases de pruebas: el nombre DEBE contener "test"
SQL_URL_TEST=postgres://postgres@127.0.0.1:5432/minijuegos_test
MONGO_URI_TEST=mongodb://127.0.0.1:27017/minijuegos-test
# Actividades de 10 ejercicios: apagado por defecto (el plan habilita solo 5 en la primera versión)
PERMITIR_10_EJERCICIOS=false

# Generación de actividades con IA. APAGADA por defecto (S4-08): hace falta confirmar presupuesto y autorización.
AI_ENABLED=false
# "falso" (fixtures del catálogo, sin proveedor ni costo) o "gemini" (llamada real, con costo)
AI_PROVEEDOR=falso
# Límites por docente (valores iniciales del plan)
AI_MAX_DIARIAS=3
AI_MAX_SIMULTANEAS=1
# Al poner AI_ENABLED=true hay que definir TODOS estos valores o el servidor no arranca.
# Salen de la prueba del modelo y del presupuesto que apruebe el equipo; no hay valores por defecto.
# AI_TIEMPO_LIMITE_MS=       tiempo máximo de una llamada al generador
# AI_MARGEN_CONCILIACION_MS= margen extra antes de dar por interrumpida una generación
# AI_PRESUPUESTO_MENSUAL=    presupuesto global del mes (misma moneda que las tarifas)
# AI_COSTO_MAXIMO_LLAMADA=   costo máximo de una llamada; se reserva antes de llamar
# AI_TARIFA_ENTRADA_MTOK=    tarifa por millón de tokens de entrada
# AI_TARIFA_SALIDA_MTOK=     tarifa por millón de tokens de salida
# Solo con AI_PROVEEDOR=gemini (sin valores por defecto; el servidor no arranca si falta alguno):
# GEMINI_API_KEY=            clave del proveedor; NUNCA se sube al repositorio
# GEMINI_MODELO=             modelo elegido tras la prueba de S4-06
# AI_MAX_TOKENS_SALIDA=      tope de tokens de salida por llamada (alimenta AI_COSTO_MAXIMO_LLAMADA)
# GEMINI_RAZONAMIENTO=       opcional: tope de tokens de razonamiento. En modelos que razonan comparte el tope de salida;
#                            si respuestas cortadas (GENERADOR_RESPUESTA_INCOMPLETA) aparecen en la medición, fíjelo bajo.
# Día calendario para el cupo diario de IA (las fechas se guardan en UTC)
ZONA_HORARIA=America/Guayaquil
# Sesión del docente (cookie HttpOnly guardada en MongoDB). Obligatorio en producción: una cadena larga y
# aleatoria (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# Sin él, en desarrollo se usa uno temporal y las sesiones se pierden al reiniciar el servidor.
SESSION_SECRET=
# Orígenes permitidos por CORS (separados por coma). Vacío en desarrollo: el cliente usa el proxy de Vite.
APP_ORIGIN=
# production activa la cookie Secure (solo HTTPS) y confía en el proxy para detectarlo
NODE_ENV=development
