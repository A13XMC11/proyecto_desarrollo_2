PORT=3977
# PostgreSQL (Sequelize): docentes, cursos, estudiantes, generaciones y cuotas de IA
SQL_URL=postgres://postgres@127.0.0.1:5432/minijuegos_dev
# true (por defecto) ajusta las tablas a los modelos al arrancar; false en producción
SQL_SYNC_ALTER=true
# MongoDB (Mongoose): juegos, versiones, partidas, canales e interacciones
MONGO_URI=mongodb://127.0.0.1:27017/minijuegos-dev
# Bases de pruebas: el nombre DEBE contener "test"
SQL_URL_TEST=postgres://postgres@127.0.0.1:5432/minijuegos_test
MONGO_URI_TEST=mongodb://127.0.0.1:27017/minijuegos-test
# Actividades de 10 ejercicios: habilitadas por defecto desde el sprint 7; false las limita a 5
PERMITIR_10_EJERCICIOS=true

# Generación de actividades con IA. APAGADA por defecto (S4-08): hace falta confirmar presupuesto y autorización.
AI_ENABLED=false
# "falso" (fixtures del catálogo, sin proveedor ni costo), "openai" (proveedor real previsto, con costo) o "gemini" (alternativa, con costo)
AI_PROVEEDOR=falso
# Solo con AI_PROVEEDOR=falso: espera simulada (en milisegundos) antes de que el generador falso responda, para ver el estado
# "generando" en la pantalla o probar tiempos límite y cancelaciones. Vacía o sin definir = sin demora. Un valor que no sea un
# entero de 0 o más impide arrancar. Debe ser menor que AI_TIEMPO_LIMITE_MS o la generación falla por tiempo agotado.
GENERADOR_FALSO_DEMORA_MS=
# Temática libre (el docente escribe cualquier temática en vez de elegir una del catálogo). APAGADA por defecto: solo "true" la enciende.
# Necesita AI_ENABLED=true (con la IA apagada sigue respondiendo GENERACION_DESHABILITADA). Apagada, una solicitud libre responde 503
# GENERACION_LIBRE_DESHABILITADA ANTES de reservar cupo; el modo catálogo no depende de ella. Antes de encenderla con el proveedor real
# conviene medir su costo (docs/generacion-ia.md) y validar la ampliación con el docente de la asignatura.
GENERACION_LIBRE_HABILITADA=false
# Límites por docente (valores iniciales del plan)
AI_MAX_DIARIAS=3
AI_MAX_SIMULTANEAS=1
# Recomendaciones de repaso con IA («¿Qué repasar?») por docente y mes. Usan el mismo presupuesto global y la misma
# configuración de proveedor que la generación, pero un contador propio (no gastan el cupo diario de actividades).
AI_MAX_RECOMENDACIONES_MENSUALES=20
# OBLIGATORIAS con AI_ENABLED=true (las SEIS): si falta o es inválida cualquiera, el servidor NO arranca.
# Salen de la prueba del modelo y del presupuesto que apruebe el equipo; no hay valores por defecto.
# AI_TIEMPO_LIMITE_MS=       entero >= 1: tiempo máximo de una llamada al generador
# AI_MARGEN_CONCILIACION_MS= entero >= 0: margen extra antes de dar por interrumpida una generación
# AI_PRESUPUESTO_MENSUAL=    número > 0: presupuesto global del mes (misma moneda que las tarifas)
# AI_COSTO_MAXIMO_LLAMADA=   número > 0: costo máximo de una llamada; se reserva antes de llamar
# AI_TARIFA_ENTRADA_MTOK=    número >= 0: tarifa por millón de tokens de entrada
# AI_TARIFA_SALIDA_MTOK=     número >= 0: tarifa por millón de tokens de salida
#
# Para PROBAR con el generador falso (sin proveedor, red ni costo), por ejemplo en la terminal y sin tocar este archivo.
# Valores FICTICIOS: no sirven para el proveedor real (ver docs/guion-demostracion.md y docs/despliegue.md):
#   AI_ENABLED=true AI_PROVEEDOR=falso GENERACION_LIBRE_HABILITADA=true
#   AI_TIEMPO_LIMITE_MS=30000 AI_MARGEN_CONCILIACION_MS=60000 AI_PRESUPUESTO_MENSUAL=1
#   AI_COSTO_MAXIMO_LLAMADA=0.01 AI_TARIFA_ENTRADA_MTOK=0 AI_TARIFA_SALIDA_MTOK=0
# Solo con AI_PROVEEDOR=openai (sin valores por defecto; el servidor no arranca si falta alguno):
# OPENAI_API_KEY=            clave del proveedor; NUNCA se sube al repositorio
# OPENAI_MODELO=             modelo elegido tras medir costo y calidad con scripts/medirGeneracion.js
# AI_MAX_TOKENS_SALIDA=      tope de tokens de salida por llamada (alimenta AI_COSTO_MAXIMO_LLAMADA); incluye el razonamiento
# OPENAI_RAZONAMIENTO=       opcional: valor de reasoning_effort (p. ej. low) para modelos que razonan. Si no se define, no se envía.
# Solo con AI_PROVEEDOR=gemini (sin valores por defecto; el servidor no arranca si falta alguno):
# GEMINI_API_KEY=            clave del proveedor; NUNCA se sube al repositorio
# GEMINI_MODELO=             modelo elegido tras la prueba de S4-06
# AI_MAX_TOKENS_SALIDA=      tope de tokens de salida por llamada (alimenta AI_COSTO_MAXIMO_LLAMADA)
# GEMINI_RAZONAMIENTO=       opcional: tope de tokens de razonamiento. En modelos que razonan comparte el tope de salida;
#                            si respuestas cortadas (GENERADOR_RESPUESTA_INCOMPLETA) aparecen en la medición, fíjelo bajo.
# Día calendario para el cupo diario de IA (las fechas se guardan en UTC)
ZONA_HORARIA=America/Guayaquil
# Sesión del docente (cookie HttpOnly guardada en MongoDB). Obligatorio en producción: una cadena larga y
# aleatoria (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# Sin él, en desarrollo se usa uno temporal y las sesiones se pierden al reiniciar el servidor.
SESSION_SECRET=
# Orígenes permitidos por CORS (separados por coma). Vacío en desarrollo: el cliente usa el proxy de Vite.
APP_ORIGIN=
# production activa la cookie Secure (solo HTTPS) y confía en el proxy para detectarlo
NODE_ENV=development
