PORT=3977
# PostgreSQL (Sequelize): docentes, cursos, estudiantes, generaciones y cuotas de IA
SQL_URL=postgres://postgres@127.0.0.1:5432/minijuegos_dev
# true (por defecto) ajusta las tablas a los modelos al arrancar; false en producción
SQL_SYNC_ALTER=true
# MongoDB (Mongoose): juegos, versiones, partidas, canales e interacciones
MONGO_URI=mongodb://127.0.0.1:27017/minijuegos-dev
# Bases de pruebas: el nombre DEBE contener "test"
SQL_URL_TEST=postgres://postgres@127.0.0.1:5432/minijuegos_test
MONGO_URI_TEST=mongodb://127.0.0.1:27017/minijuegos-test
# Actividades de 10 ejercicios: apagado por defecto (el plan habilita solo 5 en la primera versión)
PERMITIR_10_EJERCICIOS=false
# Generación de actividades con IA (sprint 4). Apagada por defecto: con false, pedir una generación
# responde 429 GENERACION_DESHABILITADA y la biblioteca sigue funcionando.
# En desarrollo se usa el generador falso (sin costo); el proveedor real (API de Claude) se conecta en producción.
AI_ENABLED=true
# Generaciones por docente y día (día calendario de ZONA_HORARIA) y tope global por mes
IA_CUPO_DIARIO=3
IA_CUPO_GLOBAL_MENSUAL=100
ZONA_HORARIA=America/Guayaquil
# Tiempo máximo de espera al proveedor; pasado el doble (mínimo 5 min) la conciliación la marca interrumpida
IA_TIEMPO_LIMITE_MS=60000
# Demora simulada del generador falso, para ver los estados "En cola" / "Generando" en la interfaz
GENERADOR_FALSO_DEMORA_MS=2000
