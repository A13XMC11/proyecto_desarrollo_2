PORT=3977
# PostgreSQL (Sequelize): docentes, cursos, estudiantes, generaciones y cuotas de IA
SQL_URL=postgres://postgres@127.0.0.1:5432/minijuegos_dev
# true (por defecto) ajusta las tablas a los modelos al arrancar; false en producción
SQL_SYNC_ALTER=true
# MongoDB (Mongoose): juegos, versiones, partidas, canales e interacciones
MONGO_URI=mongodb://127.0.0.1:27017/minijuegos-dev
# Bases de pruebas: el nombre DEBE contener "test"
SQL_URL_TEST=postgres://postgres@127.0.0.1:5432/minijuegos_test
MONGO_URI_TEST=mongodb://127.0.0.1:27017/minijuegos-test
