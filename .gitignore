# Entrega actual: servidor hexagonal, sus pruebas y la documentación que describe
# el código implementado. Los planes y diagramas anteriores quedan locales.
/*
!/.gitignore
!/server-v2/
!/client/

# Archivos necesarios para instalar, ejecutar y verificar el servidor.
/server-v2/*
!/server-v2/.gitignore
!/server-v2/.env.example
!/server-v2/README.md
!/server-v2/index.js
!/server-v2/package.json
!/server-v2/package-lock.json
!/server-v2/src/
!/server-v2/tests/
# Herramientas de medición y verificación, y la documentación operativa del servidor.
!/server-v2/scripts/
!/server-v2/docs/

# Dependencias, secretos y archivos generados dentro del código permitido.
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/Thumbs.db
**/coverage/
**/.nyc_output/
**/*.log
**/*.tsbuildinfo
**/.cache/

# Instrucciones locales de Claude Code
**/CLAUDE.md

# Capturas de pruebas de navegador
.playwright-mcp/

# Cliente: se versiona todo menos lo generado
/client/dist/
/client/dist-ssr/
